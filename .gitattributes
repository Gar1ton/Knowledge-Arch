# 规范化文本行尾
* text=auto
*.sh text eol=lf

# 发布源码包（tag 的 zip / tar.gz）与 main 一致：与 .release-exclude 保持同步（测试会核对）。
/.release-exclude export-ignore
/CLAUDE.md export-ignore
/AGENTS.md export-ignore
/CONVENTIONS.md export-ignore
/TODO.md export-ignore
/ARCHITECTURE.md export-ignore
/docs/** export-ignore
/docs/RELEASE.md -export-ignore
/docs/NOTION_SYNC.md -export-ignore
/dev/** export-ignore
/tools/** export-ignore
/.github/workflows/tests.yml export-ignore
/.github/scripts/** export-ignore
/tests/backend/test_build_main.py export-ignore
